{
  "name": "eventkit",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@eventkit/web",
    "dev:dashboard": "turbo dev --filter=@eventkit/dashboard",
    "dev:event": "turbo dev --filter=@eventkit/event",
    "dev:checkin": "turbo dev --filter=@eventkit/checkin",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:push": "pnpm --filter @eventkit/db db:push",
    "db:studio": "pnpm --filter @eventkit/db db:studio",
    "db:generate": "pnpm --filter @eventkit/db db:generate",
    "db:migrate": "pnpm --filter @eventkit/db db:migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.11.0"
}
